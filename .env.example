# Retro Raiders — server configuration.
# Copy to .env for local use; the app reads real environment variables.
# Load a file locally with:  node --env-file=.env dist/server/index.js
# Never commit a real token or key.

# Port the HTTP server binds to (Render sets this automatically).
PORT=3000

# --- Optional: AI generation via OpenRouter ---------------------------------
# Without a key the game still works: characters and the dungeon are built by
# the deterministic local generator instead.
OPENROUTER_API_KEY=
# Default text model. OPENROUTER_MODEL is still accepted as a legacy alias.
OPENROUTER_TEXT_MODEL=openai/gpt-4o-mini
# Dropdown options shown to the facilitator, comma separated.
# Optional label syntax: model-id|Human label
OPENROUTER_MODEL_OPTIONS="openai/gpt-4o-mini|GPT-4o mini - cheap solid default,openai/gpt-4.1-mini|GPT-4.1 mini - better wording,openai/gpt-4.1|GPT-4.1 - stronger, pricier,anthropic/claude-sonnet-4|Claude Sonnet 4 - creative,google/gemini-2.5-flash|Gemini 2.5 Flash - fast,z-ai/glm-5.3-flash|GLM 5.3 Flash - experimental cheap"
# Reserved for a later real image integration. Current avatars are local CSS/emoji cards.
OPENROUTER_IMAGE_MODEL=
# Sent to OpenRouter as attribution headers. Optional.
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=Retro Raiders

# --- Optional: saving the retro JSON to GitHub ------------------------------
# Without these the game still works; Markus gets "Download JSON".
# Fine-grained personal access token with Repository permissions:
#   Contents: Read and write   (nothing else is needed)
GITHUB_TOKEN=
# The account or organisation that owns the repository, e.g. WinMarkus
GITHUB_OWNER=
# The repository the snapshots are committed to, e.g. retro-raiders
GITHUB_REPO=
# Branch to commit to. Defaults to main when empty.
GITHUB_BRANCH=main
