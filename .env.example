# Retro Raiders — server configuration.
# Copy to .env for local notes; the app reads real environment variables only.
# Never commit a real token.

# Port the HTTP server binds to (Render sets this automatically).
PORT=3000

# --- Optional: saving the retro JSON to GitHub -------------------------------
# Without these the game runs normally; Markus simply gets "Download JSON".
# Fine-grained personal access token with Repository permissions:
#   Contents: Read and write   (nothing else is needed)
GITHUB_TOKEN=
# The account or organisation that owns the repository, e.g. akarion
GITHUB_OWNER=
# The repository the snapshots are committed to, e.g. team-retros
GITHUB_REPO=
# Branch to commit to. Defaults to main when empty.
GITHUB_BRANCH=main
